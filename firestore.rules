rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasText(value) {
      return value is string && value.size() > 0;
    }

    function validOwnerEmail(emailField) {
      return emailField is string && emailField.size() > 0;
    }

    // Tarefas: leitura ampla e validacao basica de payload para escrita.
    match /tasks/{taskId} {
      allow read: if true;

      allow create: if hasText(request.resource.data.task)
        && validOwnerEmail(request.resource.data.email)
        && request.resource.data.createdAt is timestamp;

      allow update, delete: if true;

      // Threads: leitura publica e validacao de estrutura para escrita.
      match /threads/{commentId} {
        allow read: if true;

        // Escrita via client desabilitada: criacao/exclusao passam pela API server-side.
        allow create, update, delete: if false;
      }
    }
  }
}
